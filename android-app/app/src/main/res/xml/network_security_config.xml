<?xml version="1.0" encoding="utf-8"?>
<!-- Allows plain HTTP only to localhost — needed for the opt-in "share with district" feature
     to reach the local demo backend (backend/app.py) during development/testing, e.g. via
     `adb reverse tcp:5000 tcp:5000`. Everything else in the app stays on the OS default
     (cleartext blocked) since this is the one deliberately-online feature (see AlertApi.kt). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
