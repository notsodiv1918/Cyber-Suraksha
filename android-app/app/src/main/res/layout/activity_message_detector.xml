<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ============ HEADER ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="44dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:paddingEnd="12dp"
            android:paddingVertical="4dp" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Message Detector"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/langBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_outline_white"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="हिं"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/detectTabRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ============ INPUT SECTION ============ -->
            <LinearLayout
                android:id="@+id/inputSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_round_blue"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_icon_round_green">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_mail"
                            android:tint="@color/accent_blue"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/headingText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="Check if a message is a scam"
                        android:textColor="@color/text_main"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/subText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Paste any SMS, WhatsApp message or link below."
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">

                    <EditText
                        android:id="@+id/messageInput"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:background="@drawable/bg_input_round"
                        android:gravity="top|start"
                        android:padding="14dp"
                        android:paddingBottom="28dp"
                        android:hint="Paste the message here..."
                        android:textColorHint="@color/text_muted"
                        android:inputType="textMultiLine"
                        android:textSize="14sp"
                        android:textColor="@color/text_main" />

                    <TextView
                        android:id="@+id/charCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="10dp"
                        android:text="0/500"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/uploadBtn"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_outline_green"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_upload"
                        android:tint="@color/primary"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/uploadBtnText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Upload photo / video"
                        android:textColor="@color/primary"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/uploadStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text=""
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/checkBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_primary_green"
                    android:layout_marginBottom="18dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        android:tint="@color/white"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/checkBtnText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Check Message"
                        android:textColor="@color/white"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/trySampleLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Try a sample message"
                    android:textColor="@color/text_main"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/sampleList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:id="@+id/historyLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recent message checks"
                    android:textColor="@color/text_main"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/historyList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ============ RESULT SECTION ============ -->
            <LinearLayout
                android:id="@+id/resultSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/resultHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_round_yellow"
                    android:padding="22dp"
                    android:layout_marginBottom="16dp">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_icon_round_green">

                        <ImageView
                            android:id="@+id/resultIcon"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_shield_alert"
                            android:tint="@color/danger"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/resultVerdictText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="Likely Scam"
                        android:textColor="@color/danger"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:textSize="21sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Risk Score:"
                            android:textColor="@color/text_main"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/resultScoreBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_risk"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="92%"
                            android:textColor="@color/white"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/whySuspiciousLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Why it's suspicious?"
                    android:textColor="@color/text_main"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/reasonsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="18dp" />

                <LinearLayout
                    android:id="@+id/reportBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_primary_green"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_flag"
                        android:tint="@color/white"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/reportBtnText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Report This"
                        android:textColor="@color/white"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/checkAnotherBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_outline_green"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/checkAnotherBtnText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Check Another"
                        android:textColor="@color/primary"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_round_blue"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_info"
                        android:tint="@color/accent_blue"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/onDeviceNoteText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Analysed on your device. No message is sent to the internet."
                        android:textColor="@color/text_main"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/navBottom"
        layout="@layout/nav_bottom" />

</LinearLayout>
