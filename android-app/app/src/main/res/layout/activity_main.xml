<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/navy"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="40dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cyber Suraksha"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/langBtn"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/navy"
            android:paddingHorizontal="16dp"
            android:paddingBottom="14dp"
            android:text="On-device SMS and call scam detector"
            android:textColor="#D9E8F7"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_margin="14dp"
            android:padding="16dp"
            android:elevation="1dp">

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Protection status"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/smsStatusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SMS auto-scan: off"
                    android:textColor="@color/text_muted"
                    android:textSize="13.5sp" />

                <Button
                    android:id="@+id/smsEnableBtn"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enable"
                    android:textColor="@color/saffron"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/callStatusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Call screening: off"
                    android:textColor="@color/text_muted"
                    android:textSize="13.5sp" />

                <Button
                    android:id="@+id/callEnableBtn"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enable"
                    android:textColor="@color/saffron"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="14dp"
            android:padding="16dp"
            android:elevation="1dp">

            <TextView
                android:id="@+id/checkLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Paste a message to check"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@color/bg"
                android:gravity="top|start"
                android:padding="10dp"
                android:hint="Paste SMS text here..."
                android:inputType="textMultiLine"
                android:textSize="14sp" />

            <Button
                android:id="@+id/checkBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/saffron"
                android:text="Check message"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:textSize="13.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/historyLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:text="Recent activity"
            android:textColor="@color/text_main"
            android:textStyle="bold"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="14dp" />

    </LinearLayout>
</ScrollView>
