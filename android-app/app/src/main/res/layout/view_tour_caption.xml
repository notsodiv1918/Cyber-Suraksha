<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tourCaptionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white_round"
    android:padding="18dp"
    android:elevation="10dp">

    <TextView
        android:id="@+id/tourCaptionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="मैसेज जाँचव"
        android:textColor="@color/text_main"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:textSize="17sp"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:id="@+id/tourDotsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tourSkipBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="छोड़व"
            android:textColor="@color/text_muted"
            android:fontFamily="sans-serif-medium"
            android:textSize="13.5sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/tourNextBtn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:background="@drawable/bg_btn_primary_green"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tourNextBtnText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="आगू बढ़व"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
